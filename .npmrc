# The landmarks-3d plugin (0.0.3) declares an exact peer dep on
# @tomtom-org/maps-sdk@0.49.1, but it actually requires 0.50.0+ (it imports
# isProxyCredentialsMode, which only exists there). The pin is stale, so npm's
# strict peer resolution (npm ci in CI) errors out. Relax it until the plugin
# ships a corrected peer range.
legacy-peer-deps=true
