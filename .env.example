# Copy this file to `.env` and fill in the values.
# Vite exposes any var prefixed with VITE_ to client code as `import.meta.env.VITE_*`.

VITE_TOMTOM_API_KEY=your-tomtom-api-key-here

# Restricted-entry gate password. Client-side check — bypassable by anyone
# who inspects the bundle. Use only as a soft "don't share casually" lock.
# Leave unset locally to fall back to the dev placeholder ("orbis-demo").
VITE_ACCESS_PASSWORD=change-me
